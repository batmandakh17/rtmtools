/*
  rtmsample_grid.dlg -- rtmtools 0.5.0 (25oct2026)
  Dialog for: rtmsample grid (spatially spread draw of cells or points, serpentine systematic; no R)
*/

VERSION 16.0

INCLUDE _std_medium
DEFINE _dlght 420
INCLUDE header

HELP hlp1, view("help rtmsample##grid")
RESET res1

DIALOG main, label("rtmsample grid - Spatially spread draw from a grid frame in memory") tabtitle("Main")
BEGIN
  TEXT     tx_xy         _lft    _top    _iwd    .,			///
	label("Coordinates of the units, x then y (a frame from rtmframe grid has x y, in metres):")
  VARLIST  vl_xy         @       _ss     _iwd    .,			///
	label("Coordinates")						///
	option(xy)
  TEXT     tx_n          _lft    _ls     _iwd    .,			///
	label("Sample size per stratum: a number, or a variable constant within strata:")
  EDIT     ed_n          @       _ss     200     .,			///
	label("Sample size")						///
	option(n)
  TEXT     tx_strata     _lft    _ls     _iwd    .,			///
	label("Strata (optional):")
  VARLIST  vl_strata     @       _ss     _iwd    .,			///
	label("Strata")							///
	option(strata)
  TEXT     tx_pps        _lft    _ls     _iwd    .,			///
	label("Measure of size for PPS (optional; blank = equal probabilities):")
  VARNAME  vn_pps        @       _ss     _vnwd   .,			///
	label("Measure of size")					///
	option(pps)
  TEXT     tx_bands      _lft    _ls     250     .,			///
	label("Horizontal bands of the serpentine order (0 = about sqrt(units)):")
  SPINNER  sp_bands      260     @       70      .,			///
	label("Bands")							///
	min(0) max(1000) default(0)					///
	option(bands)
  TEXT     tx_res        _lft    _ls     250     .,			///
	label("Reserve units per stratum (next in the order; 0 = none; or 'all'):")
  EDIT     ed_res        260     @       80      .,			///
	label("Reserve")						///
	default(0)							///
	option(reserve)
  TEXT     tx_seed       _lft    _ls     250     .,			///
	label("Seed (blank: chosen at random and reported):")
  EDIT     ed_seed       260     @       120     .,			///
	label("Seed")							///
	numonly							///
	option(seed)
  TEXT     tx_id         _lft    _ls     250     .,			///
	label("Unit identifier (optional, for the export):")
  VARLIST  vl_id         260     @       120     .,			///
	label("Identifier")						///
	option(id)
  TEXT     tx_gen        _lft    _ls     250     .,			///
	label("Prefix of the new variables (_sel _pi _w _order _reserve):")
  EDIT     ed_gen        260     @       120     .,			///
	label("Prefix")							///
	default(g)							///
	option(generate)
  CHECKBOX ck_replace    _lft    _ms     200     .,			///
	label("Replace them if they exist")				///
	option(replace)
  TEXT     tx_note       _lft    _ls     _iwd    .,			///
	label("Systematic selection along a serpentine geographic order (UN 2008 paras 77-79). Not GRTS: see the help.")
END

INCLUDE ifin

PROGRAM command
BEGIN
	put "rtmsample grid "
	INCLUDE _ifin_pr
	beginoptions
		require main.vl_xy
		optionarg main.vl_xy
		require main.ed_n
		optionarg main.ed_n
		require main.ed_gen
		optionarg main.ed_gen
		optionarg main.vl_strata
		optionarg main.vn_pps
		if !main.sp_bands.isdefault() {
			optionarg main.sp_bands
		}
		if !main.ed_res.isdefault() {
			optionarg main.ed_res
		}
		optionarg main.ed_seed
		optionarg main.vl_id
		option main.ck_replace
	endoptions
END
