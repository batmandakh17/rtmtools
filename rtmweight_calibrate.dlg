/*
  rtmweight_calibrate.dlg -- rtmtools 0.1.0 (24oct2026)
  Dialog for: rtmweight calibrate
*/

VERSION 16.0

INCLUDE _std_medium
DEFINE _dlght 440
INCLUDE header

HELP hlp1, view("help rtmweight##calibrate")
RESET res1

LIST meth_list
BEGIN
	"Raking to the margins of the calibration variables (multiplicative distance)"
	"Linear (GREG) calibration; bounds below give truncated linear calibration"
	"Post-stratification to the cells of one variable"
END

LIST meth_vals
BEGIN
	rake
	regress
	post
END

LIST eng_list
BEGIN
	"Stata: svycal (Stata 18)"
	"Stata: ipfraking (raking; trimming of the factors as approximate bounds)"
	"R: ReGenesees (logit distance, exact bounds, constrained trimming, cluster-constant weights)"
END

LIST eng_vals
BEGIN
	stata
	ipfraking
	regenesees
END

LIST dist_list
BEGIN
	"as the method (raking or linear)"
	"logit (needs bounds)"
	"raking"
	"linear"
END

LIST dist_vals
BEGIN
	""
	logit
	raking
	linear
END

DIALOG main, label("rtmweight calibrate - Calibrate weights to population totals") tabtitle("Data")
BEGIN
  TEXT     tx_cal        _lft    _top    _iwd    .,			///
	label("Calibration variables (categorical; for method regress, c.var adds a continuous total):")
  VARLIST  vl_cal        @       _ss     @       .,			///
	label("Calibration variables")					///
	fv
  TEXT     tx_w          _lft    _ls     _iwd    .,			///
	label("Weight to calibrate (after the nonresponse adjustment and any trimming):")
  VARNAME  vn_w          @       _ss     _vnwd   .,			///
	label("Weight to calibrate")
  TEXT     tx_gen        _lft    _ls     _iwd    .,			///
	label("Name of the calibrated weight variable:")
  EDIT     ed_gen        @       _ss     _vnwd   .,			///
	label("New variable")						///
	default(w2)							///
	option(generate)
  CHECKBOX ck_replace    _vnsep  @       200   .,			///
	label("Replace it if it exists")				///
	option(replace)
  GROUPBOX gb_tot        _lft    _xls    _iwd    125,		///
	label("Population totals")
  RADIO    rb_pairs      _ilft   _ss     _ibwd   ., first		///
	label("Typed as level.variable=total pairs or a matrix name, e.g. 1.region=14781 2.region=15345 0.urban=31458 1.urban=28373")	///
	onclickon(script tot_pairs)
  EDIT     ed_tot        _iilft _ss    _ibwd   .,			///
	label("Totals")							///
	option(totals)
  RADIO    rb_file       _ilft   _ms     _ibwd   ., last		///
	label("From a Stata file with the variables variable, level, total:")	///
	onclickon(script tot_file)
  FILE     fi_tot        _iilft _ss    _ibwd   .,			///
	label("Browse...")						///
	filter("Stata data (*.dta)|*.dta|All files (*.*)|*.*")		///
	option(totalsfile)
END

DIALOG meth, tabtitle("Method")
BEGIN
  TEXT     tx_meth       _lft    _top    _iwd    .,			///
	label("Calibration method (default: raking, HFPS Vol. 2 Annex A2.2):")
  COMBOBOX cb_meth       @       _ss     _iwd    .,			///
	dropdownlist							///
	contents(meth_list)						///
	values(meth_vals)						///
	default(rake)							///
	option(method)
  TEXT     tx_eng        _lft    _ls     _iwd    .,			///
	label("Engine (default: Stata's svycal):")
  COMBOBOX cb_eng        @       _ss     _iwd    .,			///
	dropdownlist							///
	contents(eng_list)						///
	values(eng_vals)						///
	default(stata)							///
	option(engine)							///
	onselchange(program eng_changed)
  TEXT     tx_dist       _lft    _ls     _iwd    .,			///
	label("Distance (ReGenesees only):")
  COMBOBOX cb_dist       @       _ss     _iwd    .,			///
	dropdownlist							///
	contents(dist_list)						///
	values(dist_vals)						///
	option(distance)
  TEXT     tx_bnd        _lft    _ls     _iwd    .,			///
	label("Bounds on the weight ratios (optional; no cited default). Stata/ipfraking: lower and upper limit; ReGenesees: bounds(low high)")
  TEXT     tx_ll         _lft    _ss     60      .,			///
	label("Lower:")
  EDIT     ed_ll         +60     @       60  .,			///
	label("Lower limit")						///
	numonly								///
	option(ll)
  TEXT     tx_ul         +90     @       60      .,			///
	label("Upper:")
  EDIT     ed_ul         +60     @       60  .,			///
	label("Upper limit")						///
	numonly								///
	option(ul)
  TEXT     tx_trim       _lft    _ls     _iwd    .,			///
	label("ReGenesees trimcal: keep the calibrated weights within (low high), preserving the totals:")
  EDIT     ed_trim       @       _ss     _vnwd   .,			///
	label("trimcal range")						///
	option(trimcal)
  TEXT     tx_ids        _lft    _ls     _iwd    .,			///
	label("ReGenesees: unit id (unique) and strata:")
  VARNAME  vn_ids        @       _ss     _vnwd   .,			///
	label("Unit id")						///
	option(ids)
  VARNAME  vn_str        _vnsep  @       _vnwd   .,			///
	label("Strata")							///
	option(strata)
  CHECKBOX ck_agg        _lft    _ms     _iwd    .,			///
	label("Weights constant within the id (calibrate at the cluster level)")	///
	option(aggregate)
END

SCRIPT tot_pairs
BEGIN
	main.ed_tot.enable
	main.fi_tot.disable
END

SCRIPT tot_file
BEGIN
	main.ed_tot.disable
	main.fi_tot.enable
END

PROGRAM eng_changed
BEGIN
	if meth.cb_eng.iseq("regenesees") {
		call meth.cb_dist.enable
		call meth.ed_trim.enable
		call meth.vn_ids.enable
		call meth.vn_str.enable
		call meth.ck_agg.enable
	}
	else {
		call meth.cb_dist.disable
		call meth.ed_trim.disable
		call meth.vn_ids.disable
		call meth.vn_str.disable
		call meth.ck_agg.disable
	}
END

SCRIPT POSTINIT
BEGIN
	script tot_pairs
	program eng_changed
END

INCLUDE ifin

PROGRAM command
BEGIN
	put "rtmweight calibrate "
	require main.vl_cal
	varlist main.vl_cal
	require main.vn_w
	put " [pw=" main.vn_w "]"
	INCLUDE _ifin_pr
	beginoptions
		require main.ed_gen
		optionarg main.ed_gen
		option main.ck_replace
		if main.rb_pairs {
			require main.ed_tot
			optionarg main.ed_tot
		}
		else {
			require main.fi_tot
			optionarg main.fi_tot
		}
		optionarg meth.cb_meth
		optionarg meth.cb_eng
		if meth.cb_eng.iseq("regenesees") {
			if !meth.cb_dist.iseq("") {
				optionarg meth.cb_dist
			}
			if meth.ed_ll | meth.ed_ul {
				put " bounds(" meth.ed_ll " " meth.ed_ul ")"
			}
			optionarg meth.ed_trim
			require meth.vn_ids
			optionarg meth.vn_ids
			optionarg meth.vn_str
			option meth.ck_agg
		}
		else {
			optionarg meth.ed_ll
			optionarg meth.ed_ul
		}
	endoptions
END
