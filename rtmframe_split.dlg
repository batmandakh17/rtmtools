/*
  rtmframe_split.dlg -- rtmtools 0.5.0 (25oct2026)
  Dialog for: rtmframe split (split large grid cells into parts; no R)
*/

VERSION 16.0

INCLUDE _std_xxwide
DEFINE _dlght 300
INCLUDE header

HELP hlp1, view("help rtmframe##split")
RESET res1

DIALOG main, label("rtmframe split - Split large cells into parts") tabtitle("Main")
BEGIN
  TEXT     tx_cells      _lft    _top    _iwd    .,			///
	label("Cells to split (cell_id values, separated by spaces); the grid frame must be in memory:")
  EDIT     ed_cells      @       _ss     _iwd    .,			///
	label("Cells")							///
	option(cells)
  TEXT     tx_parts      _lft    _ls     250     .,			///
	label("Parts per side (2 = 2 x 2, 3 = 3 x 3, ...):")
  SPINNER  sp_parts      260     @       70      .,			///
	label("Parts")							///
	min(2) max(10) default(2)					///
	option(parts)
  TEXT     tx_pix        _lft    _ls     _iwd    .,			///
	label("Pixel table written by rtmframe grid, savingpixels():")
  FILE     fi_pix        @       _ss     _iwd    .,			///
	label("Browse...")						///
	filter("Stata data (*.dta)|*.dta")				///
	option(pixels)
  TEXT     tx_sav        _lft    _ls     _iwd    .,			///
	label("Save the parts to (optional):")
  FILE     fi_sav        @       _ss     _iwd    .,			///
	label("Browse...")						///
	save								///
	filter("Stata data (*.dta)|*.dta")				///
	option(saving)
  CHECKBOX ck_replace    _lft    _ls     300     .,			///
	label("Replace the file if it exists")				///
	option(replace)
  CHECKBOX ck_clear      _lft    _ms     300     .,			///
	label("Put the parts in memory in place of the frame")		///
	option(clear)
END

PROGRAM command
BEGIN
	put "rtmframe split, "
	beginoptions
		require main.ed_cells
		optionarg main.ed_cells
		optionarg main.sp_parts
		require main.fi_pix
		optionarg main.fi_pix
		optionarg main.fi_sav
		option main.ck_replace
		option main.ck_clear
	endoptions
END
