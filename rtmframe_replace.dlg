/*
  rtmframe_replace.dlg -- rtmtools 0.5.0 (25oct2026)
  Dialog for: rtmframe replace (replacement candidates for grid cells; no R)
*/

VERSION 16.0

INCLUDE _std_medium
DEFINE _dlght 340
INCLUDE header

HELP hlp1, view("help rtmframe##replace")
RESET res1

LIST adj_list
BEGIN
	"Queen: cells sharing a side or a corner"
	"Rook: cells sharing a side"
END

LIST adj_vals
BEGIN
	queen
	rook
END

DIALOG main, label("rtmframe replace - Replacement candidates for cells that cannot be surveyed") tabtitle("Main")
BEGIN
  TEXT     tx_cells      _lft    _top    _iwd    .,			///
	label("Cells to replace (cell_id values, separated by spaces); the grid frame must be in memory:")
  EDIT     ed_cells      @       _ss     _iwd    .,			///
	label("Cells")							///
	option(cells)
  TEXT     tx_adj        _lft    _ls     _iwd    .,			///
	label("Adjacency:")
  COMBOBOX cb_adj        @       _ss     _iwd    .,			///
	dropdownlist							///
	contents(adj_list)						///
	values(adj_vals)						///
	default(queen)							///
	option(adjacency)
  TEXT     tx_sel        _lft    _ls     250     .,			///
	label("Selection flag (1 = already in the sample; optional):")
  VARNAME  vn_sel        260     @       _vnwd   .,			///
	label("Selected")						///
	option(selected)
  TEXT     tx_exc        _lft    _ls     250     .,			///
	label("Exclusion flag (1 = cannot be used; optional):")
  VARNAME  vn_exc        260     @       _vnwd   .,			///
	label("Excluded")						///
	option(exclude)
  TEXT     tx_nc         _lft    _ls     250     .,			///
	label("Candidates per cell:")
  SPINNER  sp_nc         260     @       70      .,			///
	label("Candidates")						///
	min(1) max(20) default(3)					///
	option(ncand)
  TEXT     tx_gen        _lft    _ls     250     .,			///
	label("Prefix of the new variables (_for _rank; optional):")
  EDIT     ed_gen        260     @       120     .,			///
	label("Prefix")							///
	option(generate)
  TEXT     tx_sav        _lft    _ls     _iwd    .,			///
	label("Save the candidate list to (optional):")
  FILE     fi_sav        @       _ss     _iwd    .,			///
	label("Browse...")						///
	save								///
	filter("Stata data (*.dta)|*.dta")				///
	option(saving)
  CHECKBOX ck_replace    _lft    _ls     300     .,			///
	label("Replace the file or variables if they exist")		///
	option(replace)
END

PROGRAM command
BEGIN
	put "rtmframe replace, "
	beginoptions
		require main.ed_cells
		optionarg main.ed_cells
		optionarg main.cb_adj
		optionarg main.vn_sel
		optionarg main.vn_exc
		if !main.sp_nc.isdefault() {
			optionarg main.sp_nc
		}
		optionarg main.ed_gen
		optionarg main.fi_sav
		option main.ck_replace
	endoptions
END
