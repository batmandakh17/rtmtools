/*
  rtmframe_grid.dlg -- rtmtools 0.5.0 (25oct2026)
  Dialog for: rtmframe grid (grid frame from a population raster and boundaries; no R)
*/

VERSION 16.0

INCLUDE _std_medium
DEFINE _dlght 470
INCLUDE header

HELP hlp1, view("help rtmframe##grid")
RESET res1

DIALOG main, label("rtmframe grid - Grid frame from a population raster and boundaries") tabtitle("Main")
BEGIN
  TEXT     tx_shp        _lft    _top    _iwd    .,			///
	label("Boundaries: an ESRI shapefile (.shp) in a projected coordinate system (metres):")
  FILE     fi_shp        @       _ss     _iwd    .,			///
	label("Browse...")						///
	filter("Shapefile (*.shp)|*.shp|All files (*.*)|*.*")
  TEXT     tx_ras        _lft    _ls     _iwd    .,			///
	label("Population raster: an ESRI ASCII grid (.asc) in the same coordinate system (GeoTIFF: convert once in QGIS):")
  FILE     fi_ras        @       _ss     _iwd    .,			///
	label("Browse...")						///
	filter("ESRI ASCII grid (*.asc)|*.asc|All files (*.*)|*.*")	///
	option(raster)
  TEXT     tx_cs         _lft    _ls     250     .,			///
	label("Cell size (metres):")
  EDIT     ed_cs         260     @       100     .,			///
	label("Cell size")						///
	numonly default(5000)						///
	option(cellsize)
  TEXT     tx_str        _lft    _ls     250     .,			///
	label("Stratum: an attribute of the shapefile (optional):")
  EDIT     ed_str        260     @       150     .,			///
	label("Stratum attribute")					///
	option(strata)
  TEXT     tx_id         _lft    _ls     250     .,			///
	label("Unit name: an attribute of the shapefile (optional):")
  EDIT     ed_id         260     @       150     .,			///
	label("Unit attribute")						///
	option(id)
  TEXT     tx_min        _lft    _ls     250     .,			///
	label("Flag cells with population below (0 = no flag):")
  EDIT     ed_min        260     @       100     .,			///
	label("Minimum population")					///
	numonly default(0)						///
	option(minsize)
  TEXT     tx_blk        _lft    _ls     250     .,			///
	label("Aggregate pixels into blocks of (1 = none; speeds up large rasters):")
  SPINNER  sp_blk        260     @       70      .,			///
	label("Blocks")							///
	min(1) max(100) default(1)					///
	option(blocks)
  TEXT     tx_sav        _lft    _ls     _iwd    .,			///
	label("Save the cell frame to (optional):")
  FILE     fi_sav        @       _ss     _iwd    .,			///
	label("Browse...")						///
	save								///
	filter("Stata data (*.dta)|*.dta")				///
	option(saving)
  TEXT     tx_pix        _lft    _ls     _iwd    .,			///
	label("Save the pixel table to (optional; needed by rtmframe split):")
  FILE     fi_pix        @       _ss     _iwd    .,			///
	label("Browse...")						///
	save								///
	filter("Stata data (*.dta)|*.dta")				///
	option(savingpixels)
  CHECKBOX ck_replace    _lft    _ls     300     .,			///
	label("Replace the saved files if they exist")			///
	option(replace)
  TEXT     tx_note       _lft    _ls     _iwd    .,			///
	label("The cell frame replaces the data in memory (unsaved changes stop the command unless saved first).")
END

PROGRAM command
BEGIN
	put "rtmframe grid using "
	require main.fi_shp
	put `"""' main.fi_shp `"""'
	beginoptions
		require main.fi_ras
		optionarg main.fi_ras
		require main.ed_cs
		optionarg main.ed_cs
		optionarg main.ed_str
		optionarg main.ed_id
		if !main.ed_min.isdefault() {
			optionarg main.ed_min
		}
		if !main.sp_blk.isdefault() {
			optionarg main.sp_blk
		}
		optionarg main.fi_sav
		optionarg main.fi_pix
		option main.ck_replace
		put " clear"
	endoptions
END
